<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Builds one assembly per supported RimWorld version.
      dotnet build -c Release -p:RimWorldVersion=1.6
      dotnet build -c Release -p:RimWorldVersion=1.5
    Each build references the matching Krafs.Rimworld.Ref package and writes to
    <mod root>/<version>/Assemblies. See build.sh for the full pipeline.
  -->
  <PropertyGroup>
    <RimWorldVersion Condition="'$(RimWorldVersion)' == ''">1.6</RimWorldVersion>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ModularPowerArmor</RootNamespace>
    <AssemblyName>ModularPowerArmor</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>1.0.0</Version>
    <OutputPath>../../$(RimWorldVersion)/Assemblies/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- Per-version intermediate folders (obj/1.5, obj/1.6) must not be compiled into each other. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RimWorldVersion)' == '1.5'">
    <DefineConstants>$(DefineConstants);RW_1_5</DefineConstants>
    <RimWorldRefVersion>1.5.4409</RimWorldRefVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RimWorldVersion)' == '1.6'">
    <DefineConstants>$(DefineConstants);RW_1_6</DefineConstants>
    <RimWorldRefVersion>1.6.4871</RimWorldRefVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Krafs.Rimworld.Ref" Version="$(RimWorldRefVersion)" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
