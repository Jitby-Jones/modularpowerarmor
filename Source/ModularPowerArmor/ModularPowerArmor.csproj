<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Builds one assembly per supported RimWorld version.
      dotnet build -c Release -p:RimWorldVersion=1.7
      dotnet build -c Release -p:RimWorldVersion=1.6
      dotnet build -c Release -p:RimWorldVersion=1.5
    Each build references the matching Krafs.Rimworld.Ref package and writes to
    <mod root>/<version>/Assemblies. RimWorld 1.7 runs on .NET 10 (net10.0, needs the .NET 10 SDK);
    1.5 and 1.6 run on Mono (net472). See build.sh for the full pipeline.
  -->
  <PropertyGroup>
    <RimWorldVersion Condition="'$(RimWorldVersion)' == ''">1.6</RimWorldVersion>
    <TargetFramework Condition="'$(RimWorldVersion)' == '1.7'">net10.0</TargetFramework>
    <TargetFramework Condition="'$(RimWorldVersion)' != '1.7'">net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ModularPowerArmor</RootNamespace>
    <AssemblyName>ModularPowerArmor</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>1.0.0</Version>
    <OutputPath>../../$(RimWorldVersion)/Assemblies/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- Per-version intermediate folders (obj/1.5, obj/1.6) must not be compiled into each other. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RimWorldVersion)' == '1.5'">
    <DefineConstants>$(DefineConstants);RW_1_5</DefineConstants>
    <RimWorldRefVersion>1.5.4409</RimWorldRefVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RimWorldVersion)' == '1.6'">
    <DefineConstants>$(DefineConstants);RW_1_6</DefineConstants>
    <RimWorldRefVersion>1.6.4871</RimWorldRefVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RimWorldVersion)' == '1.7'">
    <DefineConstants>$(DefineConstants);RW_1_7</DefineConstants>
    <RimWorldRefVersion>1.7.4990-unstable</RimWorldRefVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Krafs.Rimworld.Ref" Version="$(RimWorldRefVersion)" ExcludeAssets="runtime" />
    <!-- Compile-time only: the Harmony mod (brrainz.harmony) provides 0Harmony.dll in game. -->
    <PackageReference Include="Lib.Harmony.Ref" Version="2.3.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
