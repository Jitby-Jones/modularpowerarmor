<?xml version="1.0" encoding="utf-8"?>
<!--
	Combat Extended compatibility. This folder is only loaded when Combat Extended is active (see LoadFolders.xml).

	CE measures sharp armor in mm RHA and blunt armor in MPa, so armor bonuses are converted here.
	Modifications apply their armor bonus to the armor piece's own stat, which CE reads through
	GetStatValue, so CE's partial armor multipliers (for hands, neck and so on) still apply on top.

	Night vision isn't touched: CE caches apparel night vision per armor type and quality, so a
	per-item bonus wouldn't apply reliably. Instead the multispectral sensor array clears darkness,
	weather and smoke from CE's aiming report directly (in the mod's code), and its Sight bonus and
	blindness immunity work the same in CE.
-->
<Patch>

	<!-- ===== Inventory bulk for every modification (individual modules override below) ===== -->
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[@Name="MPA_ModuleBase"]/statBases</xpath>
		<value>
			<Bulk>2</Bulk>
		</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="MPA_Module_AdditionalPlating"]/statBases</xpath>
		<value>
			<Bulk>6</Bulk>
		</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="MPA_Module_Exoframe"]/statBases</xpath>
		<value>
			<Bulk>8</Bulk>
		</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="MPA_Module_UraniumPlating"]/statBases</xpath>
		<value>
			<Bulk>10</Bulk>
		</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="MPA_Module_RigidityMatrix" or defName="MPA_Module_LongjumpHydraulics"]/statBases</xpath>
		<value>
			<Bulk>5</Bulk>
		</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="MPA_Module_SecondMind"]/statBases</xpath>
		<value>
			<Bulk>1</Bulk>
		</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="MPA_Module_BiogelServos"]/statBases</xpath>
		<value>
			<Bulk>4</Bulk>
		</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="MPA_Module_ThermalRegulator" or defName="MPA_Module_AblativeShielding"]/statBases</xpath>
		<value>
			<Bulk>3</Bulk>
		</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="MPA_Module_BionicSynchronization" or defName="MPA_Module_StressDampener" or defName="MPA_Module_TargetingUplink" or defName="MPA_Module_MultispectralVisor"]/statBases</xpath>
		<value>
			<Bulk>1</Bulk>
		</value>
	</Operation>

	<!-- ===== Additional plating: +4mm RHA sharp, +9 MPa blunt (CE marine armor is 20mm / 45 MPa) ===== -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="MPA_Module_AdditionalPlating"]/comps/li[@Class="ModularPowerArmor.CompProperties_ArmorModule"]/armorStatOffsets</xpath>
		<value>
			<armorStatOffsets>
				<ArmorRating_Sharp>4</ArmorRating_Sharp>
				<ArmorRating_Blunt>9</ArmorRating_Blunt>
			</armorStatOffsets>
		</value>
	</Operation>

	<!-- ===== Uranium composite plating: +11mm RHA sharp, +25 MPa blunt (the same 45:20 blunt-to-sharp ratio as CE marine armor) ===== -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="MPA_Module_UraniumPlating"]/comps/li[@Class="ModularPowerArmor.CompProperties_ArmorModule"]/armorStatOffsets</xpath>
		<value>
			<armorStatOffsets>
				<ArmorRating_Sharp>11</ArmorRating_Sharp>
				<ArmorRating_Blunt>25</ArmorRating_Blunt>
			</armorStatOffsets>
		</value>
	</Operation>

	<!-- ===== Neural stress dampener: also halves how easily the wearer is suppressed ===== -->
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="MPA_Module_StressDampener"]/comps/li[@Class="ModularPowerArmor.CompProperties_ArmorModule"]</xpath>
		<value>
			<wearerStatFactors>
				<Suppressability>0.5</Suppressability>
			</wearerStatFactors>
		</value>
	</Operation>

	<!-- ===== Targeting uplink: better lead and range estimation ===== -->
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="MPA_Module_TargetingUplink"]/comps/li[@Class="ModularPowerArmor.CompProperties_ArmorModule"]</xpath>
		<value>
			<wearerStatOffsets>
				<AimingAccuracy>0.10</AimingAccuracy>
			</wearerStatOffsets>
		</value>
	</Operation>

	<!-- ===== Load-bearing exoframe: CE inventory capacity on top of hauling capacity ===== -->
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="MPA_Module_Exoframe"]/comps/li[@Class="ModularPowerArmor.CompProperties_ArmorModule"]</xpath>
		<value>
			<wearerStatOffsets>
				<CarryWeight>25</CarryWeight>
				<CarryBulk>5</CarryBulk>
			</wearerStatOffsets>
		</value>
	</Operation>

	<!-- ===== Descriptions ===== -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="MPA_Module_StressDampener"]/description</xpath>
		<value>
			<description>Counters the wearer's stress hormones with micro-doses and targeted neural stimulation, lowering their mental break threshold and making them harder to suppress.</description>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="MPA_Module_TargetingUplink"]/description</xpath>
		<value>
			<description>A ballistic computer and laser rangefinder that feed firing solutions straight to the wearer's visor. Speeds up aiming and improves accuracy.</description>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="MPA_Module_Exoframe"]/description</xpath>
		<value>
			<description>An external spine, hip frame and leg struts that take the weight of the wearer's gear and put more force behind their blows. Improves carrying capacity, carry weight, bulk and melee damage.</description>
		</value>
	</Operation>

</Patch>
