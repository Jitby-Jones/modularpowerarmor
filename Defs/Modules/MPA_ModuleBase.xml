<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!--
		Shared settings for armor modification items.

		Each modification's effects live in its ModularPowerArmor.CompProperties_ArmorModule and are
		the Normal-quality values. Quality changes every effect by 15% per tier (configurable in the
		mod settings): offsets scale directly, and factors scale their distance from 1.
		  Awful 70% | Poor 85% | Normal 100% | Good 115% | Excellent 130% | Masterwork 145% | Legendary 160%

		Module recipes that don't name a research prerequisite are given "Powered armor" at startup
		(falling back to "Advanced fabrication").
	-->
	<ThingDef Name="MPA_ModuleBase" Abstract="True">
		<thingClass>ThingWithComps</thingClass>
		<category>Item</category>
		<drawerType>MapMeshOnly</drawerType>
		<altitudeLayer>Item</altitudeLayer>
		<selectable>true</selectable>
		<useHitPoints>true</useHitPoints>
		<alwaysHaulable>true</alwaysHaulable>
		<rotatable>false</rotatable>
		<pathCost>14</pathCost>
		<stackLimit>1</stackLimit>
		<techLevel>Spacer</techLevel>
		<tradeability>All</tradeability>
		<healthAffectsPrice>true</healthAffectsPrice>
		<smeltable>true</smeltable>
		<soundInteract>Metal_Drop</soundInteract>
		<soundDrop>Standard_Drop</soundDrop>
		<graphicData>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(0.85, 0.85)</drawSize>
		</graphicData>
		<statBases>
			<MaxHitPoints>100</MaxHitPoints>
			<Flammability>0.2</Flammability>
			<DeteriorationRate>1</DeteriorationRate>
			<Beauty>-3</Beauty>
			<Mass>2</Mass>
			<WorkToMake>12000</WorkToMake>
			<MPA_ComputationalLoadCost>2</MPA_ComputationalLoadCost>
		</statBases>
		<thingCategories>
			<li>MPA_ArmorModules</li>
		</thingCategories>
		<comps>
			<li Class="CompProperties_Forbiddable" />
			<li>
				<compClass>CompQuality</compClass>
			</li>
		</comps>
		<recipeMaker>
			<workSpeedStat>GeneralLaborSpeed</workSpeedStat>
			<workSkill>Crafting</workSkill>
			<effectWorking>Smith</effectWorking>
			<soundWorking>Recipe_Machining</soundWorking>
			<unfinishedThingDef>UnfinishedTechArmor</unfinishedThingDef>
			<recipeUsers>
				<li>FabricationBench</li>
			</recipeUsers>
			<skillRequirements>
				<Crafting>6</Crafting>
			</skillRequirements>
		</recipeMaker>
	</ThingDef>

</Defs>
