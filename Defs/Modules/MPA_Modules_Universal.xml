<?xml version="1.0" encoding="utf-8"?>
<!-- Universal modifications: fit both body armor and helmets. -->
<Defs>

	<!-- ===================== Additional plating ===================== -->
	<ThingDef ParentName="MPA_ModuleBase">
		<defName>MPA_Module_AdditionalPlating</defName>
		<label>additional plating</label>
		<description>Bolt-on plasteel-ceramic composite plates that thicken the shell of a power armor piece. Adds roughly 4mm RHA of protection to the piece it is mounted on.\n\nCan't share a piece with uranium composite plating.\n\nFits body armor and helmets.</description>
		<graphicData>
			<texPath>ModularPowerArmor/Items/AdditionalPlating</texPath>
		</graphicData>
		<statBases>
			<MaxHitPoints>150</MaxHitPoints>
			<Mass>5</Mass>
			<WorkToMake>12000</WorkToMake>
			<MPA_ComputationalLoadCost>2</MPA_ComputationalLoadCost>
		</statBases>
		<costList>
			<Plasteel>45</Plasteel>
			<Uranium>15</Uranium>
		</costList>
		<comps>
			<li Class="ModularPowerArmor.CompProperties_ArmorModule">
				<slots>
					<li>Body</li>
					<li>Helmet</li>
				</slots>
				<exclusionTags>
					<li>Plating</li>
				</exclusionTags>
				<!-- 4mm RHA is about 20% sharp armor on marine armor (106% vanilla / 20mm RHA in Combat Extended). -->
				<armorStatOffsets>
					<ArmorRating_Sharp>0.20</ArmorRating_Sharp>
					<ArmorRating_Blunt>0.09</ArmorRating_Blunt>
				</armorStatOffsets>
				<bodyRenderNodes>
					<li Class="ModularPowerArmor.PawnRenderNodeProperties_ArmorModule">
						<debugLabel>MPA additional plating (body)</debugLabel>
						<texPath>ModularPowerArmor/Worn/Body/Plating_{fit}/Plating_{fit}</texPath>
						<bodyTypeTextures>true</bodyTypeTextures>
						<layerFraction>0.2</layerFraction>
					</li>
				</bodyRenderNodes>
				<helmetRenderNodes>
					<li Class="ModularPowerArmor.PawnRenderNodeProperties_ArmorModule">
						<debugLabel>MPA additional plating (helmet)</debugLabel>
						<texPath>ModularPowerArmor/Worn/Head/Plating_{fit}/Plating_{fit}</texPath>
						<layerFraction>0.2</layerFraction>
						<visibleFacing>
							<li>South</li>
							<li>East</li>
							<li>West</li>
						</visibleFacing>
					</li>
				</helmetRenderNodes>
			</li>
		</comps>
	</ThingDef>

	<!-- ===================== Bionic synchronization ===================== -->
	<ThingDef ParentName="MPA_ModuleBase">
		<defName>MPA_Module_BionicSynchronization</defName>
		<label>bionic synchronization</label>
		<description>A neural handshake suite that lets the armor's control systems talk directly to the wearer's bionic and implanted parts. Every other modification on the same armor piece becomes 2% more effective for each bionic-grade (spacer tech or better) implant or replacement part in the wearer.\n\nDoesn't affect computational load bonuses.\n\nFits body armor and helmets.</description>
		<graphicData>
			<texPath>ModularPowerArmor/Items/BionicSynchronization</texPath>
		</graphicData>
		<statBases>
			<Mass>1</Mass>
			<WorkToMake>15000</WorkToMake>
			<MPA_ComputationalLoadCost>3</MPA_ComputationalLoadCost>
		</statBases>
		<costList>
			<ComponentSpacer>2</ComponentSpacer>
			<Gold>15</Gold>
			<Plasteel>15</Plasteel>
		</costList>
		<recipeMaker>
			<skillRequirements>
				<Crafting>8</Crafting>
			</skillRequirements>
		</recipeMaker>
		<comps>
			<li Class="ModularPowerArmor.CompProperties_ArmorModule">
				<slots>
					<li>Body</li>
					<li>Helmet</li>
				</slots>
				<bionicSyncPerImplant>0.02</bionicSyncPerImplant>
				<bionicSyncMinTechLevel>Spacer</bionicSyncMinTechLevel>
				<helmetRenderNodes>
					<li Class="ModularPowerArmor.PawnRenderNodeProperties_ArmorModule">
						<debugLabel>MPA neural link (helmet)</debugLabel>
						<texPath>ModularPowerArmor/Worn/Head/NeuralLink_{fit}/NeuralLink_{fit}</texPath>
						<layerFraction>0.6</layerFraction>
						<visibleFacing>
							<li>North</li>
							<li>East</li>
							<li>West</li>
						</visibleFacing>
					</li>
				</helmetRenderNodes>
			</li>
		</comps>
	</ThingDef>

	<!-- ===================== Thermal regulation unit ===================== -->
	<ThingDef ParentName="MPA_ModuleBase">
		<defName>MPA_Module_ThermalRegulator</defName>
		<label>thermal regulation unit</label>
		<description>Back-mounted heat exchangers and a micro-coolant loop that keep the wearer comfortable across a much wider range of temperatures.\n\nFits body armor and helmets.</description>
		<graphicData>
			<texPath>ModularPowerArmor/Items/ThermalRegulator</texPath>
		</graphicData>
		<statBases>
			<Mass>3</Mass>
			<WorkToMake>8000</WorkToMake>
			<MPA_ComputationalLoadCost>1</MPA_ComputationalLoadCost>
		</statBases>
		<costList>
			<Steel>40</Steel>
			<ComponentIndustrial>3</ComponentIndustrial>
		</costList>
		<recipeMaker>
			<skillRequirements>
				<Crafting>5</Crafting>
			</skillRequirements>
		</recipeMaker>
		<comps>
			<li Class="ModularPowerArmor.CompProperties_ArmorModule">
				<slots>
					<li>Body</li>
					<li>Helmet</li>
				</slots>
				<wearerStatOffsets>
					<ComfyTemperatureMin>-8</ComfyTemperatureMin>
					<ComfyTemperatureMax>8</ComfyTemperatureMax>
				</wearerStatOffsets>
				<bodyRenderNodes>
					<li Class="ModularPowerArmor.PawnRenderNodeProperties_ArmorModule">
						<debugLabel>MPA thermal regulator (body)</debugLabel>
						<texPath>ModularPowerArmor/Worn/Body/ThermalFins_{fit}/ThermalFins_{fit}</texPath>
						<bodyTypeTextures>true</bodyTypeTextures>
						<layerFraction>0.4</layerFraction>
						<visibleFacing>
							<li>North</li>
							<li>East</li>
							<li>West</li>
						</visibleFacing>
					</li>
				</bodyRenderNodes>
			</li>
		</comps>
	</ThingDef>

	<!-- ===================== Ablative heat shielding ===================== -->
	<ThingDef ParentName="MPA_ModuleBase">
		<defName>MPA_Module_AblativeShielding</defName>
		<label>ablative heat shielding</label>
		<description>Heat-resistant ceramic tiles over a layer of fire-retardant gel. Improves the heat armor of the piece it is mounted on and makes it much harder to set alight.\n\nFits body armor and helmets.</description>
		<graphicData>
			<texPath>ModularPowerArmor/Items/AblativeShielding</texPath>
		</graphicData>
		<statBases>
			<Mass>3</Mass>
			<WorkToMake>8000</WorkToMake>
			<MPA_ComputationalLoadCost>1</MPA_ComputationalLoadCost>
		</statBases>
		<costList>
			<Plasteel>25</Plasteel>
			<Silver>20</Silver>
		</costList>
		<comps>
			<li Class="ModularPowerArmor.CompProperties_ArmorModule">
				<slots>
					<li>Body</li>
					<li>Helmet</li>
				</slots>
				<armorStatOffsets>
					<ArmorRating_Heat>0.15</ArmorRating_Heat>
				</armorStatOffsets>
				<armorStatFactors>
					<Flammability>0.5</Flammability>
				</armorStatFactors>
			</li>
		</comps>
	</ThingDef>

	<!-- ===================== Neuromemetic regenerators (defName kept from the trauma response suite for saves) ===================== -->
	<ThingDef ParentName="MPA_ModuleBase">
		<defName>MPA_Module_TraumaSuite</defName>
		<label>neuromemetic regenerators</label>
		<description>Two canisters of neuromemetic regenerative gel, fed into the wearer through ports in the armor's lining. On the body parts the armor piece covers, and the organs inside them, the gel halves pain, slowly heals injuries (old scars included), and tends a random bleeding wound every 15 seconds.\n\nFits body armor and helmets.</description>
		<graphicData>
			<texPath>ModularPowerArmor/Items/NeuromemeticRegenerators</texPath>
		</graphicData>
		<statBases>
			<Mass>2</Mass>
			<WorkToMake>10000</WorkToMake>
			<MPA_ComputationalLoadCost>2</MPA_ComputationalLoadCost>
		</statBases>
		<costList>
			<MedicineIndustrial>4</MedicineIndustrial>
			<ComponentSpacer>1</ComponentSpacer>
			<Plasteel>15</Plasteel>
		</costList>
		<comps>
			<li Class="ModularPowerArmor.CompProperties_ArmorModule">
				<slots>
					<li>Body</li>
					<li>Helmet</li>
				</slots>
				<!-- Only on the body parts the host piece covers. -->
				<coveredPainFactor>0.5</coveredPainFactor>
				<coveredHealPerDay>6</coveredHealPerDay>
				<coveredTendIntervalTicks>900</coveredTendIntervalTicks>
				<coveredTendQuality>0.8</coveredTendQuality>
				<bodyRenderNodes>
					<li Class="ModularPowerArmor.PawnRenderNodeProperties_ArmorModule">
						<debugLabel>MPA regenerators (body)</debugLabel>
						<texPath>ModularPowerArmor/Worn/Body/Regenerators_{fit}/Regenerators_{fit}</texPath>
						<bodyTypeTextures>true</bodyTypeTextures>
						<layerFraction>0.5</layerFraction>
						<visibleFacing>
							<li>North</li>
							<li>East</li>
							<li>West</li>
						</visibleFacing>
					</li>
				</bodyRenderNodes>
				<helmetRenderNodes>
					<li Class="ModularPowerArmor.PawnRenderNodeProperties_ArmorModule">
						<debugLabel>MPA regenerators (helmet)</debugLabel>
						<texPath>ModularPowerArmor/Worn/Head/Regenerators_{fit}/Regenerators_{fit}</texPath>
						<layerFraction>0.45</layerFraction>
						<visibleFacing>
							<li>North</li>
							<li>East</li>
							<li>West</li>
						</visibleFacing>
					</li>
				</helmetRenderNodes>
			</li>
		</comps>
	</ThingDef>

	<!-- ===================== Auxiliary subpersona (defName kept from the co-processor for saves) ===================== -->
	<!-- Biotech adds 3 basic subcores to the recipe (Patches/MPA_Subcores.xml); without it, 3 advanced components stand in. -->
	<ThingDef ParentName="MPA_ModuleBase">
		<defName>MPA_Module_CoProcessor</defName>
		<label>auxiliary subpersona</label>
		<description>Three low subcores wired together into a subordinate persona that takes over housekeeping from the armor's main computer. Raises the computational load of the piece it is installed in, and uses none itself.\n\nCan't be removed if the remaining modifications would no longer fit.\n\nFits body armor and helmets.</description>
		<graphicData>
			<texPath>ModularPowerArmor/Items/AuxiliarySubpersona</texPath>
		</graphicData>
		<statBases>
			<Mass>2</Mass>
			<WorkToMake>12000</WorkToMake>
			<MPA_ComputationalLoadCost>0</MPA_ComputationalLoadCost>
		</statBases>
		<costList>
			<Gold>10</Gold>
			<Plasteel>10</Plasteel>
		</costList>
		<recipeMaker>
			<skillRequirements>
				<Crafting>8</Crafting>
			</skillRequirements>
		</recipeMaker>
		<comps>
			<li Class="ModularPowerArmor.CompProperties_ArmorModule">
				<slots>
					<li>Body</li>
					<li>Helmet</li>
				</slots>
				<computationalLoadBonus>3</computationalLoadBonus>
				<bodyRenderNodes>
					<li Class="ModularPowerArmor.PawnRenderNodeProperties_ArmorModule">
						<debugLabel>MPA subpersona (body)</debugLabel>
						<texPath>ModularPowerArmor/Worn/Body/Subpersona_{fit}/Subpersona_{fit}</texPath>
						<bodyTypeTextures>true</bodyTypeTextures>
						<layerFraction>0.7</layerFraction>
						<visibleFacing>
							<li>South</li>
							<li>East</li>
							<li>West</li>
						</visibleFacing>
					</li>
				</bodyRenderNodes>
				<helmetRenderNodes>
					<li Class="ModularPowerArmor.PawnRenderNodeProperties_ArmorModule">
						<debugLabel>MPA subpersona (helmet)</debugLabel>
						<texPath>ModularPowerArmor/Worn/Head/Subpersona_{fit}/Subpersona_{fit}</texPath>
						<layerFraction>0.5</layerFraction>
					</li>
				</helmetRenderNodes>
			</li>
		</comps>
	</ThingDef>

	<!-- ===================== Neural stress dampener ===================== -->
	<ThingDef ParentName="MPA_ModuleBase">
		<defName>MPA_Module_StressDampener</defName>
		<label>neural stress dampener</label>
		<description>Monitors the wearer's stress hormones and counters them with micro-doses and targeted neural stimulation. Lowers the wearer's mental break threshold by 8%.\n\nFits body armor and helmets.</description>
		<graphicData>
			<texPath>ModularPowerArmor/Items/StressDampener</texPath>
		</graphicData>
		<statBases>
			<Mass>1</Mass>
			<WorkToMake>9000</WorkToMake>
			<MPA_ComputationalLoadCost>2</MPA_ComputationalLoadCost>
		</statBases>
		<costList>
			<ComponentSpacer>1</ComponentSpacer>
			<Gold>10</Gold>
			<Plasteel>10</Plasteel>
		</costList>
		<comps>
			<li Class="ModularPowerArmor.CompProperties_ArmorModule">
				<slots>
					<li>Body</li>
					<li>Helmet</li>
				</slots>
				<wearerStatOffsets>
					<MentalBreakThreshold>-0.08</MentalBreakThreshold>
				</wearerStatOffsets>
				<helmetRenderNodes>
					<li Class="ModularPowerArmor.PawnRenderNodeProperties_ArmorModule">
						<debugLabel>MPA stress dampener (helmet)</debugLabel>
						<texPath>ModularPowerArmor/Worn/Head/StressDampener_{fit}/StressDampener_{fit}</texPath>
						<layerFraction>0.3</layerFraction>
					</li>
				</helmetRenderNodes>
			</li>
		</comps>
	</ThingDef>

	<!-- ===================== Uranium composite plating ===================== -->
	<ThingDef ParentName="MPA_ModuleBase">
		<defName>MPA_Module_UraniumPlating</defName>
		<label>uranium composite plating</label>
		<description>Thick depleted-uranium plates bonded to a hyperweave backing. Far more protection than ordinary plating, and far more weight: adds roughly 11mm RHA of protection to the piece it is mounted on, but slows the wearer down. Better quality gives the same protection for less weight.\n\nCan't share a piece with additional plating.\n\nFits body armor and helmets.</description>
		<graphicData>
			<texPath>ModularPowerArmor/Items/UraniumPlating</texPath>
		</graphicData>
		<statBases>
			<MaxHitPoints>200</MaxHitPoints>
			<Mass>12</Mass>
			<WorkToMake>20000</WorkToMake>
			<MPA_ComputationalLoadCost>3</MPA_ComputationalLoadCost>
		</statBases>
		<costList>
			<Hyperweave>40</Hyperweave>
			<Uranium>80</Uranium>
		</costList>
		<recipeMaker>
			<skillRequirements>
				<Crafting>8</Crafting>
			</skillRequirements>
		</recipeMaker>
		<comps>
			<li Class="ModularPowerArmor.CompProperties_ArmorModule">
				<slots>
					<li>Body</li>
					<li>Helmet</li>
				</slots>
				<exclusionTags>
					<li>Plating</li>
				</exclusionTags>
				<!-- Same scale as additional plating: 11mm RHA and 25 MPa (CE) are 55% sharp and 25% blunt here. -->
				<armorStatOffsets>
					<ArmorRating_Sharp>0.55</ArmorRating_Sharp>
					<ArmorRating_Blunt>0.25</ArmorRating_Blunt>
				</armorStatOffsets>
				<!-- A drawback: better quality lessens it. -->
				<wearerStatPenaltyFactors>
					<MoveSpeed>0.8</MoveSpeed>
				</wearerStatPenaltyFactors>
				<bodyRenderNodes>
					<li Class="ModularPowerArmor.PawnRenderNodeProperties_ArmorModule">
						<debugLabel>MPA uranium plating (body)</debugLabel>
						<texPath>ModularPowerArmor/Worn/Body/UraniumPlating_{fit}/UraniumPlating_{fit}</texPath>
						<bodyTypeTextures>true</bodyTypeTextures>
						<layerFraction>0.2</layerFraction>
					</li>
				</bodyRenderNodes>
				<helmetRenderNodes>
					<li Class="ModularPowerArmor.PawnRenderNodeProperties_ArmorModule">
						<debugLabel>MPA uranium plating (helmet)</debugLabel>
						<texPath>ModularPowerArmor/Worn/Head/UraniumPlating_{fit}/UraniumPlating_{fit}</texPath>
						<layerFraction>0.2</layerFraction>
						<visibleFacing>
							<li>South</li>
							<li>East</li>
							<li>West</li>
						</visibleFacing>
					</li>
				</helmetRenderNodes>
			</li>
		</comps>
	</ThingDef>

</Defs>
