<?xml version="1.0" encoding="utf-8"?>
<!-- Helmet-only modifications. -->
<Defs>

	<!-- ===================== Targeting uplink ===================== -->
	<ThingDef ParentName="MPA_ModuleBase">
		<defName>MPA_Module_TargetingUplink</defName>
		<label>targeting uplink</label>
		<description>A helmet-mounted ballistic computer and laser rangefinder that feeds firing solutions straight to the wearer's visor. Speeds up aiming.\n\nFits helmets only.</description>
		<graphicData>
			<texPath>ModularPowerArmor/Items/TargetingUplink</texPath>
		</graphicData>
		<statBases>
			<Mass>1</Mass>
			<WorkToMake>14000</WorkToMake>
			<MPA_ComputationalLoadCost>3</MPA_ComputationalLoadCost>
		</statBases>
		<costList>
			<Plasteel>30</Plasteel>
			<ComponentIndustrial>2</ComponentIndustrial>
			<ComponentSpacer>2</ComponentSpacer>
			<Gold>5</Gold>
		</costList>
		<recipeMaker>
			<skillRequirements>
				<Crafting>7</Crafting>
			</skillRequirements>
		</recipeMaker>
		<comps>
			<li Class="ModularPowerArmor.CompProperties_ArmorModule">
				<slots>
					<li>Helmet</li>
				</slots>
				<wearerStatFactors>
					<AimingDelayFactor>0.85</AimingDelayFactor>
				</wearerStatFactors>
				<helmetRenderNodes>
					<li Class="ModularPowerArmor.PawnRenderNodeProperties_ArmorModule">
						<debugLabel>MPA targeting uplink (helmet)</debugLabel>
						<texPath>ModularPowerArmor/Worn/Head/TargetingUplink_{fit}/TargetingUplink_{fit}</texPath>
						<layerFraction>0.7</layerFraction>
					</li>
				</helmetRenderNodes>
			</li>
		</comps>
	</ThingDef>

	<!-- ===================== Multispectral sensor array (defName kept from the old visor for saves) ===================== -->
	<ThingDef ParentName="MPA_ModuleBase">
		<defName>MPA_Module_MultispectralVisor</defName>
		<label>multispectral sensor array</label>
		<description>A sensor pod for the side of a helmet: thermal, low-light and motion-tracking sensors that feed straight to the wearer's display. Improves the wearer's sight, and lets them see through blindness, darkness, fog and smoke: missing or blinded eyes, the dark, bad weather and smoke no longer hinder them.\n\nFits helmets only.</description>
		<graphicData>
			<texPath>ModularPowerArmor/Items/SensorArray</texPath>
		</graphicData>
		<statBases>
			<Mass>1</Mass>
			<WorkToMake>12000</WorkToMake>
			<MPA_ComputationalLoadCost>2</MPA_ComputationalLoadCost>
		</statBases>
		<costList>
			<Plasteel>30</Plasteel>
			<ComponentIndustrial>2</ComponentIndustrial>
			<ComponentSpacer>2</ComponentSpacer>
			<Silver>25</Silver>
		</costList>
		<comps>
			<li Class="ModularPowerArmor.CompProperties_ArmorModule">
				<slots>
					<li>Helmet</li>
				</slots>
				<wearerCapacityModifiers>
					<li>
						<capacity>Sight</capacity>
						<postFactor>1.15</postFactor>
					</li>
				</wearerCapacityModifiers>
				<seeThroughObscurement>true</seeThroughObscurement>
				<helmetRenderNodes>
					<li Class="ModularPowerArmor.PawnRenderNodeProperties_ArmorModule">
						<debugLabel>MPA sensor array (helmet)</debugLabel>
						<texPath>ModularPowerArmor/Worn/Head/SensorArray_{fit}/SensorArray_{fit}</texPath>
						<layerFraction>0.5</layerFraction>
					</li>
				</helmetRenderNodes>
			</li>
		</comps>
	</ThingDef>

	<!-- ===================== Second mind ===================== -->
	<ThingDef ParentName="MPA_ModuleBase">
		<defName>MPA_Module_SecondMind</defName>
		<label>second mind</label>
		<description>An AI persona core packed into a helmet housing and run as a co-pilot for the wearer's own mind. Raises the wearer's consciousness, and adds computational load to the helmet and to the body armor worn with it. If the helmet comes off, body armor that needs the extra load goes offline until the helmet is back on.\n\nFits helmets only.</description>
		<graphicData>
			<texPath>ModularPowerArmor/Items/SecondMind</texPath>
		</graphicData>
		<statBases>
			<Mass>2</Mass>
			<WorkToMake>20000</WorkToMake>
			<MPA_ComputationalLoadCost>0</MPA_ComputationalLoadCost>
		</statBases>
		<costList>
			<Plasteel>40</Plasteel>
			<ComponentIndustrial>2</ComponentIndustrial>
			<ComponentSpacer>5</ComponentSpacer>
			<AIPersonaCore>1</AIPersonaCore>
		</costList>
		<recipeMaker>
			<researchPrerequisite>MPA_Research_AdvancedModules</researchPrerequisite>
			<skillRequirements>
				<Crafting>8</Crafting>
			</skillRequirements>
		</recipeMaker>
		<comps>
			<li Class="ModularPowerArmor.CompProperties_ArmorModule">
				<slots>
					<li>Helmet</li>
				</slots>
				<wearerCapacityModifiers>
					<li>
						<capacity>Consciousness</capacity>
						<postFactor>1.20</postFactor>
					</li>
				</wearerCapacityModifiers>
				<computationalLoadBonus>4</computationalLoadBonus>
				<wornComputationalLoadBonus>4</wornComputationalLoadBonus>
				<generateOnNpcs>false</generateOnNpcs>
				<helmetRenderNodes>
					<li Class="ModularPowerArmor.PawnRenderNodeProperties_ArmorModule">
						<debugLabel>MPA second mind (helmet)</debugLabel>
						<texPath>ModularPowerArmor/Worn/Head/SecondMind_{fit}/SecondMind_{fit}</texPath>
						<layerFraction>0.4</layerFraction>
						<visibleFacing>
							<li>South</li>
							<li>North</li>
						</visibleFacing>
					</li>
				</helmetRenderNodes>
			</li>
		</comps>
	</ThingDef>

</Defs>
