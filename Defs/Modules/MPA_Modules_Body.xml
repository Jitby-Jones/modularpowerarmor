<?xml version="1.0" encoding="utf-8"?>
<!-- Body-armor-only modifications. -->
<Defs>

	<!-- ===================== Biogel servo replacement ===================== -->
	<ThingDef ParentName="MPA_ModuleBase">
		<defName>MPA_Module_BiogelServos</defName>
		<label>biogel servo replacement</label>
		<description>Biogel-filled artificial muscle in place of the armor's hydraulic actuators, as quick as the wearer's own. Improves manipulation and movement speed.</description>
		<graphicData>
			<texPath>ModularPowerArmor/Items/BiogelServos</texPath>
		</graphicData>
		<statBases>
			<Mass>4</Mass>
			<WorkToMake>15000</WorkToMake>
			<MPA_ComputationalLoadCost>3</MPA_ComputationalLoadCost>
		</statBases>
		<costList>
			<Plasteel>40</Plasteel>
			<ComponentIndustrial>2</ComponentIndustrial>
			<ComponentSpacer>2</ComponentSpacer>
			<MedicineIndustrial>3</MedicineIndustrial>
		</costList>
		<recipeMaker>
			<skillRequirements>
				<Crafting>8</Crafting>
			</skillRequirements>
		</recipeMaker>
		<comps>
			<li Class="ModularPowerArmor.CompProperties_ArmorModule">
				<slots>
					<li>Body</li>
				</slots>
				<wearerCapacityModifiers>
					<li>
						<capacity>Manipulation</capacity>
						<postFactor>1.20</postFactor>
					</li>
				</wearerCapacityModifiers>
				<wearerStatFactors>
					<MoveSpeed>1.10</MoveSpeed>
				</wearerStatFactors>
				<bodyRenderNodes>
					<li Class="ModularPowerArmor.PawnRenderNodeProperties_ArmorModule">
						<debugLabel>MPA biogel servos (body)</debugLabel>
						<texPath>ModularPowerArmor/Worn/Body/BiogelServos_{fit}/BiogelServos_{fit}</texPath>
						<bodyTypeTextures>true</bodyTypeTextures>
						<layerFraction>0.28</layerFraction>
					</li>
				</bodyRenderNodes>
			</li>
		</comps>
	</ThingDef>

	<!-- ===================== Load-bearing exoframe ===================== -->
	<ThingDef ParentName="MPA_ModuleBase">
		<defName>MPA_Module_Exoframe</defName>
		<label>load-bearing exoframe</label>
		<description>An external spine, hip frame and leg struts that take the weight of the wearer's gear and put more force behind their blows. Improves carrying capacity and melee damage.</description>
		<graphicData>
			<texPath>ModularPowerArmor/Items/Exoframe</texPath>
		</graphicData>
		<statBases>
			<MaxHitPoints>150</MaxHitPoints>
			<Mass>8</Mass>
			<WorkToMake>12000</WorkToMake>
			<MPA_ComputationalLoadCost>2</MPA_ComputationalLoadCost>
		</statBases>
		<costList>
			<Plasteel>40</Plasteel>
			<ComponentIndustrial>2</ComponentIndustrial>
			<ComponentSpacer>1</ComponentSpacer>
			<Steel>60</Steel>
		</costList>
		<recipeMaker>
			<skillRequirements>
				<Crafting>5</Crafting>
			</skillRequirements>
		</recipeMaker>
		<comps>
			<li Class="ModularPowerArmor.CompProperties_ArmorModule">
				<slots>
					<li>Body</li>
				</slots>
				<wearerStatFactors>
					<CarryingCapacity>1.25</CarryingCapacity>
					<MeleeDamageFactor>1.10</MeleeDamageFactor>
				</wearerStatFactors>
				<bodyRenderNodes>
					<li Class="ModularPowerArmor.PawnRenderNodeProperties_ArmorModule">
						<debugLabel>MPA exoframe (body)</debugLabel>
						<texPath>ModularPowerArmor/Worn/Body/Exoframe_{fit}/Exoframe_{fit}</texPath>
						<bodyTypeTextures>true</bodyTypeTextures>
						<layerFraction>0.08</layerFraction>
					</li>
				</bodyRenderNodes>
			</li>
		</comps>
	</ThingDef>

	<!-- ===================== Rigidity matrix ===================== -->
	<ThingDef ParentName="MPA_ModuleBase">
		<defName>MPA_Module_RigidityMatrix</defName>
		<label>rigidity matrix</label>
		<description>Field-hardened struts that lock the armor rigid the instant it's struck, spreading the impact. The wearer can't be staggered and takes less damage.</description>
		<graphicData>
			<texPath>ModularPowerArmor/Items/RigidityMatrix</texPath>
		</graphicData>
		<statBases>
			<MaxHitPoints>150</MaxHitPoints>
			<Mass>6</Mass>
			<WorkToMake>18000</WorkToMake>
			<MPA_ComputationalLoadCost>4</MPA_ComputationalLoadCost>
		</statBases>
		<costList>
			<Plasteel>50</Plasteel>
			<ComponentIndustrial>2</ComponentIndustrial>
			<ComponentSpacer>3</ComponentSpacer>
		</costList>
		<recipeMaker>
			<skillRequirements>
				<Crafting>8</Crafting>
			</skillRequirements>
		</recipeMaker>
		<comps>
			<li Class="ModularPowerArmor.CompProperties_ArmorModule">
				<slots>
					<li>Body</li>
				</slots>
				<preventStagger>true</preventStagger>
				<wearerStatFactors>
					<IncomingDamageFactor>0.75</IncomingDamageFactor>
				</wearerStatFactors>
				<bodyRenderNodes>
					<li Class="ModularPowerArmor.PawnRenderNodeProperties_ArmorModule">
						<debugLabel>MPA rigidity matrix (body)</debugLabel>
						<texPath>ModularPowerArmor/Worn/Body/RigidityMatrix_{fit}/RigidityMatrix_{fit}</texPath>
						<bodyTypeTextures>true</bodyTypeTextures>
						<layerFraction>0.14</layerFraction>
						<visibleFacing>
							<li>South</li>
							<li>East</li>
							<li>West</li>
						</visibleFacing>
					</li>
				</bodyRenderNodes>
			</li>
		</comps>
	</ThingDef>

	<!-- ===================== Second heart ===================== -->
	<!-- No quality. Biotech adds 3 high subcores to the recipe (Patches/MPA_Subcores.xml); without it, the recipe takes 4 advanced components instead of 2. -->
	<ThingDef ParentName="MPA_ModuleBase">
		<defName>MPA_Module_SecondHeart</defName>
		<label>second heart</label>
		<description>A human heart kept beating by subcores and wired into the armor's life support. Once, if the wearer's head is destroyed, it keeps them alive for a while.</description>
		<graphicData>
			<texPath>ModularPowerArmor/Items/SecondHeart</texPath>
		</graphicData>
		<statBases>
			<MaxHitPoints>80</MaxHitPoints>
			<Mass>2</Mass>
			<WorkToMake>24000</WorkToMake>
			<MPA_ComputationalLoadCost>4</MPA_ComputationalLoadCost>
		</statBases>
		<costList>
			<Plasteel>40</Plasteel>
			<ComponentIndustrial>2</ComponentIndustrial>
			<ComponentSpacer>2</ComponentSpacer>
			<Heart>1</Heart>
		</costList>
		<recipeMaker>
			<researchPrerequisite>MPA_Research_AdvancedModules</researchPrerequisite>
			<skillRequirements>
				<Crafting>8</Crafting>
			</skillRequirements>
		</recipeMaker>
		<!-- Replaces the base comps to leave out CompQuality. -->
		<comps Inherit="False">
			<li Class="CompProperties_Forbiddable" />
			<li Class="ModularPowerArmor.CompProperties_ArmorModule">
				<slots>
					<li>Body</li>
				</slots>
				<refuseDeath>true</refuseDeath>
				<generateOnNpcs>false</generateOnNpcs>
				<bodyRenderNodes>
					<li Class="ModularPowerArmor.PawnRenderNodeProperties_ArmorModule">
						<debugLabel>MPA second heart (body)</debugLabel>
						<texPath>ModularPowerArmor/Worn/Body/SecondHeart_{fit}/SecondHeart_{fit}</texPath>
						<bodyTypeTextures>true</bodyTypeTextures>
						<layerFraction>0.7</layerFraction>
						<visibleFacing>
							<li>East</li>
							<li>West</li>
							<li>North</li>
						</visibleFacing>
					</li>
				</bodyRenderNodes>
			</li>
		</comps>
	</ThingDef>

	<!-- ===================== Longjump hydraulics ===================== -->
	<ThingDef ParentName="MPA_ModuleBase">
		<defName>MPA_Module_LongjumpHydraulics</defName>
		<label>longjump hydraulics</label>
		<description>High-pressure hydraulic rams in the armor's legs that let the wearer leap over walls and through roofs, though not through mountains.</description>
		<graphicData>
			<texPath>ModularPowerArmor/Items/LongjumpHydraulics</texPath>
		</graphicData>
		<statBases>
			<MaxHitPoints>150</MaxHitPoints>
			<Mass>6</Mass>
			<WorkToMake>18000</WorkToMake>
			<MPA_ComputationalLoadCost>3</MPA_ComputationalLoadCost>
		</statBases>
		<costList>
			<Plasteel>50</Plasteel>
			<ComponentIndustrial>2</ComponentIndustrial>
			<ComponentSpacer>3</ComponentSpacer>
		</costList>
		<recipeMaker>
			<skillRequirements>
				<Crafting>8</Crafting>
			</skillRequirements>
		</recipeMaker>
		<comps>
			<li Class="ModularPowerArmor.CompProperties_ArmorModule">
				<slots>
					<li>Body</li>
				</slots>
				<longjump>
					<range>20</range>
					<cooldownTicks>2500</cooldownTicks>
				</longjump>
				<bodyRenderNodes>
					<li Class="ModularPowerArmor.PawnRenderNodeProperties_ArmorModule">
						<debugLabel>MPA longjump hydraulics (body)</debugLabel>
						<texPath>ModularPowerArmor/Worn/Body/LongjumpHydraulics_{fit}/LongjumpHydraulics_{fit}</texPath>
						<bodyTypeTextures>true</bodyTypeTextures>
						<layerFraction>0.2</layerFraction>
						<visibleFacing>
							<li>East</li>
							<li>West</li>
							<li>North</li>
						</visibleFacing>
					</li>
				</bodyRenderNodes>
			</li>
		</comps>
	</ThingDef>

</Defs>
