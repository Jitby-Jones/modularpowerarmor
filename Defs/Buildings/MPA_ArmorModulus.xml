<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!--
		Armor Modulus: where modular armor is modified.
		 - Bills (Defs/Recipes/MPA_ModulusRecipes.xml) bring armor and modifications to the station
		   and hand the finished piece back out, so armor can be modified in bulk.
		 - Right-clicking the station with a colonist selected opens a window for modifying the armor
		   that colonist is wearing; the work happens here.
		Armor lying on the ground can still be modified where it lies by right-clicking it.
	-->
	<ThingDef ParentName="BuildingBase">
		<defName>MPA_ArmorModulus</defName>
		<label>armor modulus</label>
		<description>A powered gantry for refitting power armor. Bills here install modifications into armor, or strip them out, in bulk: colonists bring the armor and the modifications, and the finished piece comes back out. Right-click it with a colonist selected to work on the armor that colonist is wearing, and to see their installed modifications and stats.</description>
		<thingClass>ModularPowerArmor.Building_ArmorModulus</thingClass>
		<graphicData>
			<texPath>ModularPowerArmor/Things/ArmorModulus/ArmorModulus</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(3,2)</drawSize>
			<damageData>
				<cornerTL>Damage/Corner</cornerTL>
				<cornerTR>Damage/Corner</cornerTR>
				<cornerBL>Damage/Corner</cornerBL>
				<cornerBR>Damage/Corner</cornerBR>
			</damageData>
		</graphicData>
		<uiIconScale>0.9</uiIconScale>
		<castEdgeShadows>true</castEdgeShadows>
		<staticSunShadowHeight>0.20</staticSunShadowHeight>
		<costList>
			<Steel>150</Steel>
			<Plasteel>60</Plasteel>
			<ComponentIndustrial>6</ComponentIndustrial>
			<ComponentSpacer>2</ComponentSpacer>
		</costList>
		<altitudeLayer>Building</altitudeLayer>
		<fillPercent>0.5</fillPercent>
		<useHitPoints>true</useHitPoints>
		<statBases>
			<WorkToBuild>9000</WorkToBuild>
			<MaxHitPoints>250</MaxHitPoints>
			<Flammability>0.5</Flammability>
			<Cleanliness>-2</Cleanliness>
		</statBases>
		<size>(3,2)</size>
		<designationCategory>Production</designationCategory>
		<passability>PassThroughOnly</passability>
		<pathCost>50</pathCost>
		<hasInteractionCell>true</hasInteractionCell>
		<interactionCellOffset>(0,0,-1)</interactionCellOffset>
		<surfaceType>Item</surfaceType>
		<constructionSkillPrerequisite>6</constructionSkillPrerequisite>
		<techLevel>Spacer</techLevel>
		<inspectorTabs>
			<li>ITab_Bills</li>
		</inspectorTabs>
		<building>
			<spawnedConceptLearnOpportunity>BillsTab</spawnedConceptLearnOpportunity>
		</building>
		<comps>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<basePowerConsumption>250</basePowerConsumption>
				<shortCircuitInRain>true</shortCircuitInRain>
			</li>
			<li Class="CompProperties_Flickable" />
			<li Class="CompProperties_Breakdownable" />
			<li Class="CompProperties_AffectedByFacilities">
				<linkableFacilities>
					<li>ToolCabinet</li>
				</linkableFacilities>
			</li>
		</comps>
		<placeWorkers>
			<li>PlaceWorker_ShowFacilitiesConnections</li>
			<li>PlaceWorker_PreventInteractionSpotOverlap</li>
		</placeWorkers>
		<researchPrerequisites>
			<li>MPA_Research_ArmorModification</li>
		</researchPrerequisites>
	</ThingDef>

	<!-- Colonists with Crafting enabled do the Armor Modulus bills. -->
	<WorkGiverDef>
		<defName>MPA_DoBillsArmorModulus</defName>
		<label>modify armor at an armor modulus</label>
		<giverClass>WorkGiver_DoBill</giverClass>
		<workType>Crafting</workType>
		<priorityInType>70</priorityInType>
		<fixedBillGiverDefs>
			<li>MPA_ArmorModulus</li>
		</fixedBillGiverDefs>
		<verb>modify armor at</verb>
		<gerund>modifying armor at</gerund>
		<requiredCapacities>
			<li>Manipulation</li>
		</requiredCapacities>
		<prioritizeSustains>true</prioritizeSustains>
	</WorkGiverDef>

</Defs>
